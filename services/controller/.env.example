# NestJS Task Controller configuration.
# Real values live in ../../secrets/controller.env (git-ignored). Generate it with:
#   node services/controller/scripts/init-secrets.mjs
# Never commit real tokens.

# --- Authentication (required, >= 32 characters, all different) ---
# Admin: task management API (Hermes, future dashboard)
CONTROLLER_ADMIN_TOKEN=
# Workers: /internal/* API. The token decides which agent's tasks a worker may claim.
CONTROLLER_CLAUDE_WORKER_TOKEN=
CONTROLLER_CODEX_WORKER_TOKEN=
# Optional: Hermes' restricted delegator token (create/view/cancel its own tasks in registered
# projects). Add it with: node services/controller/scripts/add-hermes-token.mjs
CONTROLLER_HERMES_TOKEN=

# --- Projects ---
# Comma-separated registered project ids (lowercase letters, digits, - and _).
# Tasks may only reference these; ids are opaque keys, never file paths.
CONTROLLER_PROJECT_IDS=sandbox

# --- Worker leases ---
# How long a claim stays valid without a heartbeat (30..86400 seconds).
CONTROLLER_LEASE_SECONDS=900
# How often expired leases are turned into failed tasks (1..3600 seconds).
CONTROLLER_LEASE_SWEEP_SECONDS=15

# --- Idempotency ---
# A repeated POST /tasks with the same Idempotency-Key within this window returns the first task.
CONTROLLER_IDEMPOTENCY_WINDOW_SECONDS=600

# --- /system/status probes ---
# Comma-separated name=url pairs. Any HTTP response counts as reachable.
CONTROLLER_STATUS_PROBES=hermes=http://hermes:9119/

# --- Server (defaults shown; the Docker image sets these itself) ---
# HOST=0.0.0.0
# PORT=3000
# CONTROLLER_DB_PATH=/var/lib/controller/controller.db
